# Recorded from the binaries by `cargo run -p pgconfig-golden -- record`.
tests/golden/**/*.jsonl linguist-generated=true
# Generated by `npm install` in web/, not written by hand.
web/package-lock.json linguist-generated=true
# The server embeds these files and serves them as they are, so every checkout
# keeps their LF line endings, Windows included.
parameters/** text eol=lf
# Extracted from the PostgreSQL source by `cargo run -p pgconfig-parameter-docs`,
# except the README, which is written by hand.
parameters/** linguist-generated=true
parameters/README.md -linguist-generated
